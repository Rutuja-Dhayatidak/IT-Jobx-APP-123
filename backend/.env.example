# System Settings
NODE_ENV=development
PORT=5001

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/job-portal

# JWT Authorization Configuration (Secrets must be distinct and at least 32 characters long)
JWT_ACCESS_SECRET=your_super_secret_access_key_32_characters_minimum
JWT_REFRESH_SECRET=your_super_secret_refresh_key_32_characters_minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Platform Admin Seed Account Setup (For createPlatformAdmin.js/createSuperAdmin.js scripts)
SUPER_ADMIN_EMAIL=superadmin1235@gmail.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123
SUPER_ADMIN_NAME=Super Admin

# Nodemailer / SMTP Credentials
EMAIL_USER=example@gmail.com
EMAIL_PASS=smtp_app_password

# Payment Gateways (Razorpay Keys)
RAZORPAY_KEY_ID=rzp_test_SNw35MkokY8h1y
RAZORPAY_KEY_SECRET=5swKLrcRVYl1bc512r868sqP

# Third Party Sign-in Credentials
GOOGLE_CLIENT_ID=google_client_id_here
GOOGLE_CLIENT_SECRET=google_client_secret_here

# Cloudinary Credentials
CLOUD_NAME=cloudinary_cloud_name
API_KEY=cloudinary_api_key
API_SECRET=cloudinary_api_secret

# Origin and CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# API Rate Limiting Config
GLOBAL_RATE_LIMIT_WINDOW_MINUTES=15
GLOBAL_RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_BLOCK_DURATION_MINUTES=30
OTP_RATE_LIMIT_WINDOW_MINUTES=10
OTP_MAX_REQUESTS=3
OTP_COOLDOWN_SECONDS=60
REGISTER_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_MAX=3
JOB_API_RATE_LIMIT_MAX=60
